{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gferris418/argus-intelligence/schemas/domain-result.schema.json",
  "title": "ARGUS Domain Result",
  "description": "Domain-result contract returned by ARGUS to the governing runtime. It is not the final user-facing output contract.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "objective",
    "candidate_or_opportunity",
    "decision",
    "maturity",
    "evidence",
    "unknowns_conflicts",
    "next_recommended_action"
  ],
  "properties": {
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "candidate_or_opportunity": {
      "type": "object",
      "additionalProperties": true,
      "required": ["name"],
      "properties": {
        "argus_id": {"type": ["string", "null"]},
        "name": {"type": "string", "minLength": 1},
        "record_type": {
          "type": ["string", "null"],
          "enum": ["ENTITY", "PROJECT", "PROCUREMENT", "INTELLIGENCE", "OPPORTUNITY", "SUPPLIER_PRODUCT", "KNOWLEDGE", null]
        }
      }
    },
    "country_context": {
      "type": ["object", "null"],
      "additionalProperties": true,
      "properties": {
        "country_code": {"type": ["string", "null"]},
        "route": {"type": ["string", "null"]},
        "route_confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
      }
    },
    "decision": {
      "type": "string",
      "enum": ["MONITOR", "INVESTIGATE", "PROMOTE_TO_PX", "MERGE_EXISTING", "HOLD", "REJECT"]
    },
    "decision_rationale": {
      "type": ["string", "null"]
    },
    "maturity": {
      "type": "string",
      "enum": ["I0", "I1", "I2", "I3", "I4", "I5", "I6", "I7", "I8", "I9"]
    },
    "institutional_chain": {
      "type": ["object", "null"],
      "additionalProperties": true
    },
    "project_budget_funding": {
      "type": ["object", "null"],
      "additionalProperties": true
    },
    "procurement_planning_package": {
      "type": ["object", "null"],
      "additionalProperties": true
    },
    "procurement_state_horizon": {
      "type": ["object", "null"],
      "additionalProperties": true
    },
    "commercial_relevance": {
      "type": ["object", "string", "null"]
    },
    "collection_coverage": {
      "type": "object",
      "description": "Optional decision-relative 360-degree collection coverage. Include when the task benefits from explicit coverage assessment; omission does not imply the lenses were ignored.",
      "additionalProperties": false,
      "properties": {
        "need_mission": {"type": "string", "enum": ["NOT_APPLICABLE", "UNASSESSED", "INSUFFICIENT", "PARTIAL", "ADEQUATE"]},
        "policy_strategy": {"type": "string", "enum": ["NOT_APPLICABLE", "UNASSESSED", "INSUFFICIENT", "PARTIAL", "ADEQUATE"]},
        "institution_stakeholders": {"type": "string", "enum": ["NOT_APPLICABLE", "UNASSESSED", "INSUFFICIENT", "PARTIAL", "ADEQUATE"]},
        "programme_project": {"type": "string", "enum": ["NOT_APPLICABLE", "UNASSESSED", "INSUFFICIENT", "PARTIAL", "ADEQUATE"]},
        "budget_funding": {"type": "string", "enum": ["NOT_APPLICABLE", "UNASSESSED", "INSUFFICIENT", "PARTIAL", "ADEQUATE"]},
        "procurement_acquisition": {"type": "string", "enum": ["NOT_APPLICABLE", "UNASSESSED", "INSUFFICIENT", "PARTIAL", "ADEQUATE"]},
        "technical_installed_base": {"type": "string", "enum": ["NOT_APPLICABLE", "UNASSESSED", "INSUFFICIENT", "PARTIAL", "ADEQUATE"]},
        "supplier_competitor": {"type": "string", "enum": ["NOT_APPLICABLE", "UNASSESSED", "INSUFFICIENT", "PARTIAL", "ADEQUATE"]},
        "ecosystem_influence": {"type": "string", "enum": ["NOT_APPLICABLE", "UNASSESSED", "INSUFFICIENT", "PARTIAL", "ADEQUATE"]},
        "commercial_participation": {"type": "string", "enum": ["NOT_APPLICABLE", "UNASSESSED", "INSUFFICIENT", "PARTIAL", "ADEQUATE"]},
        "timing_triggers": {"type": "string", "enum": ["NOT_APPLICABLE", "UNASSESSED", "INSUFFICIENT", "PARTIAL", "ADEQUATE"]},
        "internal_intelligence": {"type": "string", "enum": ["NOT_APPLICABLE", "UNASSESSED", "INSUFFICIENT", "PARTIAL", "ADEQUATE"]}
      }
    },
    "collection_gaps": {
      "type": "array",
      "description": "Decision-relevant gaps exposed by 360-degree collection assessment.",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["lens", "gap", "decision_impact"],
        "properties": {
          "lens": {"$ref": "#/$defs/collectionLens"},
          "gap": {"type": "string", "minLength": 1},
          "decision_impact": {"type": "string", "minLength": 1},
          "next_collection_question": {"type": ["string", "null"]},
          "next_material_trigger": {"type": ["string", "null"]}
        }
      }
    },
    "source_convergence": {
      "type": ["object", "null"],
      "additionalProperties": true,
      "properties": {
        "source_count": {"type": ["integer", "null"], "minimum": 0},
        "independent_source_lineages": {"type": ["integer", "null"], "minimum": 0},
        "single_source_dependency": {"type": ["boolean", "null"]}
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["claim", "claim_type", "claim_condition"],
        "properties": {
          "claim": {"type": "string", "minLength": 1},
          "claim_type": {
            "type": "string",
            "enum": ["FACT", "DERIVED", "INFERENCE", "ASSUMPTION", "UNKNOWN"]
          },
          "claim_condition": {
            "type": "string",
            "enum": ["CURRENT", "STALE", "CONFLICT"]
          },
          "evidence_refs": {
            "type": "array",
            "items": {"type": "string"}
          },
          "source_lineage": {"type": ["string", "null"]},
          "atlas_assurance": {
            "type": ["string", "null"],
            "enum": ["VERIFIED", "SUPPORTED", "INFERRED", "ASSUMED", "SPECULATIVE", "UNKNOWN", null]
          },
          "atlas_health": {
            "type": ["string", "null"],
            "enum": ["GREEN", "AMBER", "RED", "UNKNOWN", null]
          }
        }
      }
    },
    "unknowns_conflicts": {
      "type": "array",
      "items": {"type": "string"}
    },
    "research_frontier": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["question"],
        "properties": {
          "question": {"type": "string", "minLength": 1},
          "lens": {"anyOf": [{"$ref": "#/$defs/collectionLens"}, {"type": "null"}]},
          "decision_relevance": {"type": ["string", "null"]},
          "priority": {"type": ["integer", "null"], "minimum": 1}
        }
      }
    },
    "next_material_trigger": {
      "type": ["string", "null"]
    },
    "next_recommended_action": {
      "type": "string",
      "minLength": 1
    },
    "proposed_domain_actions": {
      "type": "array",
      "items": {"$ref": "#/$defs/proposedAction"}
    },
    "proposed_registry_actions": {
      "type": "array",
      "items": {"$ref": "#/$defs/proposedAction"}
    }
  },
  "$defs": {
    "collectionLens": {
      "type": "string",
      "enum": [
        "need_mission",
        "policy_strategy",
        "institution_stakeholders",
        "programme_project",
        "budget_funding",
        "procurement_acquisition",
        "technical_installed_base",
        "supplier_competitor",
        "ecosystem_influence",
        "commercial_participation",
        "timing_triggers",
        "internal_intelligence"
      ]
    },
    "proposedAction": {
      "type": "object",
      "additionalProperties": true,
      "required": ["action", "rationale"],
      "properties": {
        "action": {"type": "string", "minLength": 1},
        "target_argus_id": {"type": ["string", "null"]},
        "rationale": {"type": "string", "minLength": 1},
        "reversible": {"type": ["boolean", "null"]},
        "approval_hint": {
          "type": ["string", "null"],
          "description": "Advisory domain metadata only; the governing runtime determines the actual approval requirement."
        }
      }
    }
  }
}
