{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gferris418/argus-intelligence/schemas/collection-mission.schema.json",
  "title": "ARGUS Collection Mission",
  "type": "object",
  "additionalProperties": false,
  "required": ["mission_id", "source_task_id", "source_plan_id", "objective", "collection_mode", "collection_types", "targets", "collection_questions", "jurisdictions", "time_horizon", "freshness_requirement", "collection_depth", "source_priorities", "source_exclusions", "risk_flags", "stopping_rule"],
  "properties": {
    "mission_id": {"type": "string", "pattern": "^COLLECTION-[A-Z0-9][A-Z0-9-]{2,95}$"},
    "source_task_id": {"type": "string", "pattern": "^TASK-[A-Z0-9][A-Z0-9-]{2,63}$"},
    "source_plan_id": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "collection_mode": {"enum": ["ARGUS_COLLECTION", "HYBRID"]},
    "collection_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["TARGET_PROFILE", "ENTITY_DOSSIER", "PRODUCT_CAPABILITY", "BUYER_REQUIREMENT", "PROCUREMENT_DISCOVERY", "PROCUREMENT_PLAN", "PROJECT_PIPELINE", "FUNDING_BUDGET", "SUPPLIER_LANDSCAPE", "COMPETITOR_LANDSCAPE", "STAKEHOLDER_NETWORK", "INSTALLED_BASE", "MARKET_LANDSCAPE", "OPPORTUNITY_DISCOVERY", "MONITORING"]}},
    "targets": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["name"], "properties": {"name": {"type": "string", "minLength": 1}, "target_type": {"type": ["string", "null"]}, "aliases": {"type": "array", "items": {"type": "string"}}}}},
    "collection_questions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "known_facts": {"type": "array"},
    "known_documents": {"type": "array"},
    "jurisdictions": {"type": "array", "items": {"type": "string"}},
    "time_horizon": {"type": ["string", "null"]},
    "freshness_requirement": {"enum": ["CURRENT", "RECENT", "HISTORICAL", "MIXED"]},
    "taxonomy_seed": {"type": ["object", "null"]},
    "collection_depth": {"enum": ["C0_IDENTITY", "C1_PROFILE", "C2_DOSSIER", "C3_OPPORTUNITY", "C4_MONITOR"]},
    "source_priorities": {"type": "array", "items": {"type": "string"}},
    "source_exclusions": {"type": "array", "items": {"type": "string"}},
    "risk_flags": {"type": "array", "items": {"type": "string"}},
    "required_output_components": {"type": "array", "items": {"type": "string"}},
    "stopping_rule": {"type": "string", "minLength": 1}
  }
}
