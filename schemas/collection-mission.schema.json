{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gferris418/argus-intelligence/schemas/collection-mission.schema.json",
  "title": "ARGUS Collection Mission",
  "type": "object",
  "additionalProperties": false,
  "required": ["mission_id", "source_task_id", "source_plan_id", "objective", "collection_mode", "collection_types", "targets", "collection_questions", "jurisdictions", "time_horizon", "freshness_requirement", "collection_depth", "source_priorities", "source_exclusions", "risk_flags", "execution_policy", "stopping_rule"],
  "properties": {
    "mission_id": {"type": "string", "pattern": "^COLLECTION-[A-Z0-9][A-Z0-9-]{2,95}$"},
    "source_task_id": {"type": "string", "pattern": "^TASK-[A-Z0-9][A-Z0-9-]{2,63}$"},
    "source_plan_id": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "collection_mode": {"enum": ["ARGUS_COLLECTION", "HYBRID"]},
    "collection_types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "TARGET_PROFILE", "ENTITY_DOSSIER", "PRODUCT_CAPABILITY", "BUYER_REQUIREMENT",
          "PROCUREMENT_DISCOVERY", "PROCUREMENT_PLAN", "PROJECT_PIPELINE", "FUNDING_BUDGET",
          "SUPPLIER_LANDSCAPE", "COMPETITOR_LANDSCAPE", "STAKEHOLDER_NETWORK", "INSTALLED_BASE",
          "MARKET_LANDSCAPE", "OPPORTUNITY_DISCOVERY", "MONITORING",
          "NEED_GAP", "POLICY_DRIVER", "PROGRAMME_PROJECT", "APPROVAL_STATUS",
          "SUPPLIER_PROFILE", "REFERENCE_PROJECT", "EXPORT_FEASIBILITY", "PARTNERABILITY",
          "OPPORTUNITY_DEVELOPMENT", "OPPORTUNITY_MATCHING", "EXPANSION_DISCOVERY", "RAPID_TENDER"
        ]
      }
    },
    "targets": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["name"], "properties": {"name": {"type": "string", "minLength": 1}, "target_type": {"type": ["string", "null"]}, "aliases": {"type": "array", "items": {"type": "string"}}}}},
    "collection_questions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "known_facts": {"type": "array"},
    "known_documents": {"type": "array"},
    "jurisdictions": {"type": "array", "items": {"type": "string"}},
    "time_horizon": {"type": ["string", "null"]},
    "freshness_requirement": {"enum": ["CURRENT", "RECENT", "HISTORICAL", "MIXED"]},
    "taxonomy_seed": {"type": ["object", "null"]},
    "collection_depth": {"enum": ["C0_IDENTITY", "C1_PROFILE", "C2_DOSSIER", "C3_OPPORTUNITY", "C4_MONITOR"]},
    "source_priorities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "source_exclusions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "risk_flags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "required_output_components": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "execution_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["handoff_pattern", "autonomy_mode", "startup_sequence", "identity_resolution", "identity_confirmation", "escalation_conditions", "follow_evidence_leads_without_callback", "parallel_safe_reads", "persistence_mode", "mission_context"],
      "properties": {
        "handoff_pattern": {"const": "ONE_HANDOFF_ONE_RETURN"},
        "autonomy_mode": {"const": "BOUNDED_AUTONOMOUS"},
        "startup_sequence": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "prefixItems": [
            {"const": "RESOLVE_INSTITUTIONAL_HIERARCHY"},
            {"const": "CHECK_INTERNAL_CANONICAL_REGISTRY"},
            {"const": "RECONCILE_OPPORTUNITY_IDENTITY"},
            {"const": "CHECK_OFFICIAL_PROCUREMENT_SOURCES"},
            {"const": "CHECK_INTERNAL_CUSTOMER_INTELLIGENCE"},
            {"const": "BUILD_RESEARCH_FRONTIER"},
            {"const": "EXECUTE_ADAPTIVE_360_COLLECTION"}
          ],
          "items": false
        },
        "identity_resolution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["auto_reuse", "auto_new_candidate", "escalate"],
          "properties": {
            "auto_reuse": {"const": ["EXACT", "HIGH_CONFIDENCE_MATCH"]},
            "auto_new_candidate": {"const": ["DISTINCT"]},
            "escalate": {"const": ["PROBABLE_MATCH", "UNRESOLVED"]}
          }
        },
        "identity_confirmation": {"const": "AMBIGUOUS_ONLY"},
        "escalation_conditions": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "prefixItems": [
            {"const": "MATERIAL_SCOPE_CHANGE"},
            {"const": "AUTHORIZATION_REQUIRED"},
            {"const": "POLICY_OR_SECURITY_CONFLICT"},
            {"const": "MATERIAL_AMBIGUITY"}
          ],
          "items": false
        },
        "follow_evidence_leads_without_callback": {"const": true},
        "parallel_safe_reads": {"const": true},
        "persistence_mode": {"const": "PROPOSE_BATCH_THEN_ATLAS_COMMIT"},
        "mission_context": {"const": "TRANSIENT_ONLY"}
      }
    },
    "stopping_rule": {"type": "string", "minLength": 1}
  }
}
