{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gferris418/argus-intelligence/schemas/collection-plan.schema.json",
  "title": "ARGUS Internal Collection Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "plan_id",
    "mission_id",
    "objective",
    "priority_intelligence_requirements",
    "essential_elements_of_information",
    "collection_tasks",
    "source_plan",
    "target_classes",
    "competing_hypotheses",
    "collection_gaps",
    "stopping_rule"
  ],
  "properties": {
    "plan_id": {"type": "string", "pattern": "^ARGUS-PLAN-[A-Z0-9][A-Z0-9-]{2,95}$"},
    "mission_id": {"type": "string", "pattern": "^COLLECTION-[A-Z0-9][A-Z0-9-]{2,95}$"},
    "objective": {"type": "string", "minLength": 1},
    "priority_intelligence_requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "question", "priority"],
        "properties": {
          "id": {"type": "string", "pattern": "^PIR-[A-Z0-9-]+$"},
          "question": {"type": "string", "minLength": 1},
          "priority": {"enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"]}
        }
      }
    },
    "essential_elements_of_information": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "pir_id", "question", "status"],
        "properties": {
          "id": {"type": "string", "pattern": "^EEI-[A-Z0-9-]+$"},
          "pir_id": {"type": "string", "pattern": "^PIR-[A-Z0-9-]+$"},
          "question": {"type": "string", "minLength": 1},
          "status": {"enum": ["OPEN", "PARTIAL", "SATISFIED", "BLOCKED"]}
        }
      }
    },
    "collection_tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "eei_ids", "method", "status"],
        "properties": {
          "id": {"type": "string", "pattern": "^CT-[A-Z0-9-]+$"},
          "eei_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^EEI-[A-Z0-9-]+$"}, "uniqueItems": true},
          "method": {"type": "string", "minLength": 1},
          "status": {"enum": ["PLANNED", "ACTIVE", "COMPLETE", "BLOCKED"]}
        }
      }
    },
    "source_plan": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_type", "purpose", "priority", "authority_preference"],
        "properties": {
          "source_type": {"type": "string", "minLength": 1},
          "purpose": {"type": "string", "minLength": 1},
          "priority": {"enum": ["PRIMARY", "SECONDARY", "SUPPLEMENTARY"]},
          "authority_preference": {"enum": ["OFFICIAL", "PRIMARY", "AUTHORITATIVE_SECONDARY", "OPEN_SOURCE"]}
        }
      }
    },
    "target_classes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["Country", "Government Agency", "Buyer", "Company", "OEM", "Supplier", "Product", "Platform", "Programme", "Project", "Tender", "Contract", "Sector", "Technology", "Person"]}
    },
    "competing_hypotheses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "hypothesis", "status", "evidence_for", "evidence_against"],
        "properties": {
          "id": {"type": "string", "pattern": "^HYP-[A-Z0-9-]+$"},
          "hypothesis": {"type": "string", "minLength": 1},
          "status": {"enum": ["ACTIVE", "SUPPORTED", "WEAKENED", "REJECTED", "UNRESOLVED"]},
          "evidence_for": {"type": "array", "items": {"type": "string"}},
          "evidence_against": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "collection_gaps": {"type": "array", "items": {"type": "string"}},
    "stopping_rule": {"type": "string", "minLength": 1}
  }
}
