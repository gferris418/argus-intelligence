{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:access-asia:argus:master-registry-record:v0.3.0-candidate",
  "title": "ARGUS Master Registry Record v0.3.0 Candidate",
  "description": "Backward-compatible candidate envelope. Legacy v0.2.x records retain status+attributes. Candidate v0.3.0 is intentionally restricted to PROCUREMENT and uses record_state plus a deeply validated Bangladesh Procurement v2 domain_payload. This schema is not production write authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "argus_id",
    "record_type",
    "canonical_name_or_title",
    "related_argus_ids",
    "evidence_refs",
    "external_refs",
    "revision",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {"enum": ["0.2.0", "0.2.1", "0.3.0"]},
    "argus_id": {"type": "string", "minLength": 3, "maxLength": 96},
    "record_type": {"enum": ["ENTITY", "PROJECT", "PROCUREMENT", "INTELLIGENCE", "OPPORTUNITY", "SUPPLIER_PRODUCT", "KNOWLEDGE"]},
    "canonical_name_or_title": {"type": "string", "minLength": 1, "maxLength": 500},
    "status": {"type": "string", "minLength": 1, "maxLength": 120},
    "record_state": {"type": "string", "minLength": 1, "maxLength": 120},
    "aliases": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "related_argus_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["target_argus_id", "relation_type"],
        "properties": {
          "target_argus_id": {"type": "string", "minLength": 1},
          "relation_type": {"type": "string", "minLength": 1},
          "evidence_refs": {"type": "array"}
        }
      }
    },
    "evidence_refs": {"type": "array", "items": {"type": "object"}},
    "external_refs": {"type": "array", "items": {"type": "object"}},
    "information_classification": {"type": "string"},
    "revision": {"type": "integer", "minimum": 1},
    "created_at": {"type": "string", "minLength": 1},
    "updated_at": {"type": "string", "minLength": 1},
    "attributes": {"type": "object"},
    "observations": {"type": "array", "items": {"type": "object"}},
    "domain_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "version", "data"],
      "properties": {
        "profile": {"const": "BANGLADESH_PROCUREMENT"},
        "version": {"const": "2.0.0-candidate"},
        "data": {"$ref": "https://argus.accessasia.example/schemas/bangladesh-procurement-v2-domain.schema.json"}
      }
    },
    "domain_classification_refs": {"type": "array", "items": {"type": "object"}},
    "standard_refs": {"type": "array", "items": {"type": "object"}}
  },
  "allOf": [
    {
      "if": {"properties": {"schema_version": {"enum": ["0.2.0", "0.2.1"]}}, "required": ["schema_version"]},
      "then": {
        "required": ["status", "attributes"],
        "not": {"anyOf": [{"required": ["record_state"]}, {"required": ["domain_payload"]}]}
      }
    },
    {
      "if": {"properties": {"schema_version": {"const": "0.3.0"}}, "required": ["schema_version"]},
      "then": {
        "properties": {"record_type": {"const": "PROCUREMENT"}},
        "required": ["record_state", "relationships", "domain_payload", "observations"],
        "not": {"anyOf": [{"required": ["status"]}, {"required": ["attributes"]}]}
      }
    }
  ],
  "document_id": "ARGUS-SCHEMA-REG-001",
  "version": "0.3.0-candidate",
  "effective_date": "2026-10-18",
  "status": "CANDIDATE",
  "supersedes_candidate": "argus-master-registry-v0.2.1.json",
  "production_authority": false
}
