{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-os.local/schemas/execution-lease.schema.json",
  "title": "ATLAS execution lease",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "execution_lease_id",
    "handoff_id",
    "handoff_payload_sha256",
    "source_task_id",
    "source_plan_id",
    "source_work_unit_id",
    "producer",
    "consumer",
    "issued_at",
    "lease_expires_at",
    "supersedes_lease_id"
  ],
  "properties": {
    "contract_version": {"const": "1.0.0"},
    "execution_lease_id": {"type": "string", "pattern": "^LEASE-[A-Z0-9][A-Z0-9-]{2,95}$"},
    "handoff_id": {"type": "string", "pattern": "^HANDOFF-[A-Z0-9][A-Z0-9-]{2,95}$"},
    "handoff_payload_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "source_task_id": {"type": "string", "pattern": "^TASK-[A-Z0-9][A-Z0-9-]{2,63}$"},
    "source_plan_id": {"type": "string", "minLength": 1},
    "source_work_unit_id": {"type": "string", "minLength": 1},
    "producer": {"const": "ATLAS_OS"},
    "consumer": {"type": "string", "minLength": 1, "maxLength": 80},
    "issued_at": {"type": "string", "format": "date-time"},
    "lease_expires_at": {"type": "string", "format": "date-time"},
    "supersedes_lease_id": {
      "type": ["string", "null"],
      "pattern": "^LEASE-[A-Z0-9][A-Z0-9-]{2,95}$"
    }
  }
}
