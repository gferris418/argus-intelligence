{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-os.local/schemas/domain-handoff-receipt.schema.json",
  "title": "ATLAS domain handoff receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "handoff_id", "payload_sha256", "consumer", "status", "received_at"],
  "properties": {
    "contract_version": {"const": "1.1.0"},
    "handoff_id": {"type": "string", "pattern": "^HANDOFF-[A-Z0-9][A-Z0-9-]{2,95}$"},
    "payload_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "consumer": {"type": "string", "minLength": 1, "maxLength": 80},
    "status": {"enum": ["ACCEPTED", "REJECTED"]},
    "received_at": {"type": "string", "format": "date-time"},
    "reason": {"type": ["string", "null"]}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "REJECTED"}}},
      "then": {"required": ["reason"]}
    }
  ]
}
